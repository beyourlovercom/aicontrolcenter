#!/bin/zsh
set -euo pipefail
REAL_CLAUDE="/Users/a/.local/bin/claude"
AUDIT_LOG="/Users/a/.aicc-remote/CLAUDE_MODEL_DISPATCH_AUDIT.jsonl"
DEFAULT_MODEL="claude-sonnet-4-6"
DEFAULT_EFFORT="low"
SONNET5="claude-sonnet-5"

# Pure metadata/admin commands do not launch a model session.
if (( $# > 0 )); then
  case "$1" in
    --version|-v|--help|-h|update|install|doctor|mcp|plugin|auth|setup-token)
      exec "$REAL_CLAUDE" "$@"
      ;;
  esac
fi

args=("$@")
model=""
effort=""
model_index=0
effort_index=0
for ((i=1; i<=${#args}; i++)); do
  a="${args[$i]}"
  case "$a" in
    --model)
      (( i < ${#args} )) || { echo 'CLAUDE_MODEL_VALUE_MISSING' >&2; exit 64; }
      model="${args[$((i+1))]}"; model_index=$((i+1))
      ;;
    --model=*) model="${a#--model=}"; model_index=$i ;;
    --effort)
      (( i < ${#args} )) || { echo 'CLAUDE_EFFORT_VALUE_MISSING' >&2; exit 64; }
      effort="${args[$((i+1))]}"; effort_index=$((i+1))
      ;;
    --effort=*) effort="${a#--effort=}"; effort_index=$i ;;
  esac
done

if [[ "$model" == "sonnet" ]]; then
  echo 'CLAUDE_AMBIGUOUS_MODEL_ALIAS_FORBIDDEN: use exact model id; default is claude-sonnet-4-6' >&2
  exit 64
fi
if [[ -z "$model" ]]; then
  model="$DEFAULT_MODEL"
  args+=(--model "$model")
fi
if [[ "$model" == "$SONNET5"* ]]; then
  evidence="${AICC_GPT_ESCALATION_EVIDENCE:-}"
  if [[ -z "${evidence//[[:space:]]/}" ]]; then
    echo 'CLAUDE_SONNET_5_REQUIRES_GPT_ESCALATION_EVIDENCE' >&2
    exit 64
  fi
  [[ -n "$effort" ]] || { effort="medium"; args+=(--effort "$effort"); }
else
  evidence=""
  [[ -n "$effort" ]] || { effort="$DEFAULT_EFFORT"; args+=(--effort "$effort"); }
fi

mkdir -p "${AUDIT_LOG:h}"
touch "$AUDIT_LOG"
chmod 600 "$AUDIT_LOG"
AICC_AUDIT_MODEL="$model" AICC_AUDIT_EFFORT="$effort" AICC_AUDIT_EVIDENCE="$evidence" AICC_AUDIT_CWD="$PWD" python3 - "$AUDIT_LOG" <<'PY'
import datetime,json,os,sys
record={
  "timestamp":datetime.datetime.now(datetime.timezone.utc).isoformat(),
  "model":os.environ["AICC_AUDIT_MODEL"],
  "effort":os.environ["AICC_AUDIT_EFFORT"],
  "gptEscalationEvidence":os.environ["AICC_AUDIT_EVIDENCE"] or None,
  "cwd":os.environ["AICC_AUDIT_CWD"],
}
with open(sys.argv[1],"a",encoding="utf-8") as f:f.write(json.dumps(record,separators=(",",":"))+"\n")
PY

if [[ "${AICC_CLAUDE_GOVERNANCE_DRY_RUN:-0}" == "1" ]]; then
  printf 'MODEL=%s\nEFFORT=%s\nESCALATION_EVIDENCE=%s\n' "$model" "$effort" "${evidence:-}"
  exit 0
fi
exec "$REAL_CLAUDE" "${args[@]}"
