{
  "manifest_version": 3,
  "name": "BYL Woo Shipping Read-only Audit",
  "description": "Explicitly consented, local-only shipping settings inspection. No order or settings writes.",
  "version": "0.1.0",
  "permissions": ["tabs", "scripting", "downloads", "declarativeNetRequest"],
  "optional_host_permissions": [
    "https://dev.beyourlover.com/*",
    "https://www.beyourlover.com/*"
  ],
  "action": {
    "default_title": "BYL Shipping Read-only Audit",
    "default_popup": "popup.html"
  }
}
