{
  "manifest_version": 3,
  "name": "AICC GPT Bridge",
  "version": "0.1.0",
  "description": "Owner-triggered text bridge between ChatGPT Web and AICC.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:1420/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
