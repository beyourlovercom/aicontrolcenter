{
  "manifest_version": 3,
  "name": "AICC ChatGPT Bridge",
  "version": "3.8.13",
  "description": "Real-conversation projection and explicit same-conversation transport bridge for AICC.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:1420/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "AICC V3 Bridge",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
