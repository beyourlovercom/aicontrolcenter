{
  "manifest_version": 3,
  "name": "AICC ChatGPT Bridge",
  "version": "3.8.29",
  "description": "AICC bridge for real ChatGPT chat, isolated planner transport, and managed execution.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:1420/*",
    "http://127.0.0.1:1423/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "composer-text.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:1420/*",
        "http://127.0.0.1:1423/*"
      ],
      "js": [
        "aicc-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AICC V3 Bridge",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
